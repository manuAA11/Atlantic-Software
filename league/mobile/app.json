{
  "expo": {
    "name": "Atlantic League",
    "slug": "atlantic-league",
    "version": "0.2.0",
    "scheme": "atlanticleague",
    "orientation": "portrait",
    "icon": "./assets/atlantic-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlantictech.league",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.atlantictech.league",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/atlantic-icon.png",
        "backgroundColor": "#14283E"
      }
    },
    "web": {
      "favicon": "./assets/atlantic-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Elige tu foto para una historia o una evidencia de entrenamiento.",
          "cameraPermission": "Toma tu propia foto para crear una historia.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permite seleccionar tus fotos.",
          "savePhotosPermission": "Guarda tus historias de Atlantic League en tus fotos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      "expo-dev-client"
    ]
  }
}
