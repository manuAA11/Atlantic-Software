{
  "name": "@atlantic/league",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "mobile"
  ],
  "scripts": {
    "mobile": "npm --workspace @atlantic/league-mobile start",
    "typecheck": "npm --workspace @atlantic/league-mobile run typecheck",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:postgres": "node tests/postgres.mjs",
    "test:ui": "playwright test",
    "build:pwa": "node scripts/build-pwa.mjs",
    "test:training:postgres": "node tests/training-postgres.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@expo/image-utils": "0.12.5",
    "@playwright/test": "1.64.1",
    "pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
