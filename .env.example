# Solo servidor / operador: valores privados se introducen mediante secretos del host.
# No entregar este entorno al escritorio; no versionar el archivo .env con valores.
GSOFT_SUPABASE_URL=
GSOFT_SERVICE_ROLE_KEY=
META_APP_ID=
META_BUSINESS_CONFIG_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ONBOARDING_URL=
# Supabase Edge Functions inyecta SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY.
# Las credenciales Wompi de cada gimnasio se guardan por el formulario privado -> Vault.
# El escritorio usa solo GYMSOFT_SUPABASE_URL y GYMSOFT_SUPABASE_KEY publicable.
